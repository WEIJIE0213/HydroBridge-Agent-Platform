# -----------------------------------------------------------------------------
# HydroBridge AI local environment
# Copy this file to .env. Never commit the real .env file.
# -----------------------------------------------------------------------------

APP_ENV=development
APP_NAME=HydroBridge AI
APP_VERSION=1.0.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# MySQL
MYSQL_DATABASE=hydrobridge
MYSQL_USER=hydrobridge
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL=mysql+asyncmy://hydrobridge:change-me-local@mysql:3306/hydrobridge?charset=utf8mb4

# Redis
REDIS_RUNTIME_URL=redis://redis-runtime:6379/0
REDIS_CACHE_URL=redis://redis-cache:6379/0
CELERY_BROKER_URL=redis://redis-runtime:6379/1
CELERY_RESULT_BACKEND=redis://redis-runtime:6379/2

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=hydrobridge_knowledge
KNOWLEDGE_INDEX_VERSION=2
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=hydrobridge
MINIO_SECRET_KEY=change-me-minio
MINIO_SECURE=false
MINIO_BUCKET_DOCUMENTS=hydrobridge-documents
MINIO_BUCKET_ARTIFACTS=hydrobridge-artifacts

# Authentication
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
BOOTSTRAP_ADMIN_EMAIL=admin@hydrobridge.cn
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_SEED_DATA=true
BOOTSTRAP_SEED_PATH=/seed-data/achievements.json

# OpenAI-compatible model endpoint. Fill during live integration testing.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180

# Tavily is the only external web-search provider.
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=8

# Agent limits
AGENT_MAX_ITERATIONS=12
AGENT_MAX_PARALLEL_TOOLS=4
AGENT_RUN_TIMEOUT_SECONDS=600
AGENT_DAILY_TOKEN_BUDGET=1000000
AGENT_EXECUTION_MODE=celery

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hydrobridge-ai

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
